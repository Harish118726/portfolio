<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Harish Rettangi | Cloud Billing & FinOps Portfolio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: { 500: '#10b981', 600: '#059669' }
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    code, pre, .terminal-font { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-emerald-500 selection:text-white">

  <!-- Navigation -->
  <nav class="border-b border-slate-800 bg-slate-900/70 backdrop-blur sticky top-0 z-50 px-6 py-4 flex items-center justify-between max-w-6xl mx-auto">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
      <span class="font-bold tracking-tight text-lg">harish.rettangi<span class="text-emerald-500">.dev</span></span>
    </div>
    <div class="flex items-center gap-6 text-sm">
      <a href="#simulator" class="text-slate-400 hover:text-emerald-400 transition">Spend Simulator</a>
      <a href="#terminal" class="text-slate-400 hover:text-emerald-400 transition">Interactive Terminal</a>
      <a href="#timeline" class="text-slate-400 hover:text-emerald-400 transition">Timeline</a>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-6 py-12 space-y-20">

    <!-- Hero Section -->
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-medium">
        <span>Google Cloud Billing & FinOps Analytics</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">
        Engineering Financial Efficiency Across Cloud Workloads.
      </h1>
      <p class="text-slate-400 max-w-2xl text-base sm:text-lg leading-relaxed">
        Specializing in multi-cloud billing optimization, BigQuery export architectures, commitment governance (CUDs), and automated anomaly detection.
      </p>
    </header>

    <!-- Interactive FinOps Spend Simulator -->
    <section id="simulator" class="p-6 sm:p-8 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <span>FinOps Cloud Spend & ROI Simulator</span>
        </h2>
        <p class="text-sm text-slate-400">Toggle workload optimizations in real-time to model projected monthly burn and run-rate savings.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Controls -->
        <div class="space-y-5 text-sm">
          <div>
            <div class="flex justify-between text-slate-300 font-medium mb-1">
              <span>Baseline Monthly Spend</span>
              <span class="text-emerald-400 font-mono" id="baseSpendDisplay">$50,000</span>
            </div>
            <input id="baseSpend" type="range" min="10000" max="250000" step="5000" value="50000" class="w-full accent-emerald-500 bg-slate-800 rounded-lg cursor-pointer">
          </div>

          <div class="space-y-3 pt-2">
            <label class="flex items-center gap-3 p-3 bg-slate-800/60 border border-slate-700/50 rounded-xl cursor-pointer hover:border-slate-600 transition">
              <input type="checkbox" id="toggleCUD" checked class="w-4 h-4 accent-emerald-500 rounded">
              <div>
                <p class="text-white font-medium">Committed Use Discounts (CUD)</p>
                <p class="text-xs text-slate-400">Apply 3-year compute commitments (~35% discount)</p>
              </div>
            </label>

            <label class="flex items-center gap-3 p-3 bg-slate-800/60 border border-slate-700/50 rounded-xl cursor-pointer hover:border-slate-600 transition">
              <input type="checkbox" id="toggleIdle" checked class="w-4 h-4 accent-emerald-500 rounded">
              <div>
                <p class="text-white font-medium">Reclaim Orphaned Resources</p>
                <p class="text-xs text-slate-400">Purge unattached persistent disks & unassociated static IPs (~12%)</p>
              </div>
            </label>

            <label class="flex items-center gap-3 p-3 bg-slate-800/60 border border-slate-700/50 rounded-xl cursor-pointer hover:border-slate-600 transition">
              <input type="checkbox" id="toggleSpike" class="w-4 h-4 accent-emerald-500 rounded">
              <div>
                <p class="text-white font-medium">Simulate High-Traffic Egress Spike</p>
                <p class="text-xs text-slate-400">Add unpredicted outbound cross-region data transfer (+25%)</p>
              </div>
            </label>
          </div>
        </div>

        <!-- Metrics Dashboard -->
        <div class="flex flex-col justify-center space-y-4 bg-slate-950 p-6 rounded-xl border border-slate-800/80">
          <div>
            <span class="text-xs uppercase font-semibold tracking-wider text-slate-500">Projected Run Rate</span>
            <div id="projectedSpend" class="text-4xl font-extrabold text-white font-mono mt-1">$26,500<span class="text-sm font-normal text-slate-400">/mo</span></div>
          </div>
          <div class="border-t border-slate-800 pt-4 grid grid-cols-2 gap-4">
            <div>
              <span class="text-xs text-slate-400">Net Monthly Savings</span>
              <p id="netSavings" class="text-lg font-bold text-emerald-400 font-mono mt-0.5">$23,500</p>
            </div>
            <div>
              <span class="text-xs text-slate-400">Cost Reduction</span>
              <p id="savingsPercent" class="text-lg font-bold text-emerald-400 font-mono mt-0.5">47.0%</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Recruiter CLI Terminal -->
    <section id="terminal" class="rounded-xl border border-slate-800 bg-slate-900 overflow-hidden shadow-2xl">
      <div class="flex items-center justify-between px-4 py-3 bg-slate-800/60 border-b border-slate-700/60">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          <span class="ml-2 text-xs font-mono text-slate-400">recruiter-console@harish-rettangi:~$</span>
        </div>
        <span class="text-xs text-slate-400 terminal-font">Type 'help'</span>
      </div>
      <div class="p-5 text-sm terminal-font space-y-3 min-h-[220px] bg-slate-950">
        <div class="text-slate-400">Welcome to interactive CLI mode. Type <span class="text-emerald-400">help</span> to view available commands.</div>
        <div id="terminalHistory" class="space-y-2"></div>
        <div class="flex items-center gap-2 text-emerald-400">
          <span>&gt;</span>
          <input type="text" id="terminalInput" class="w-full bg-transparent border-none outline-none text-slate-100 placeholder-slate-600 terminal-font" placeholder="skills, finops, contact..." autofocus>
        </div>
      </div>
    </section>

    <!-- Career Timeline -->
    <section id="timeline" class="space-y-6">
      <h2 class="text-xl font-bold text-white tracking-tight">Professional Progression</h2>
      <div class="border-l-2 border-slate-800 ml-3 pl-6 space-y-8">
        <div class="relative">
          <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-emerald-500 ring-4 ring-slate-950"></div>
          <span class="text-xs font-mono text-emerald-400">Current</span>
          <h3 class="text-base font-semibold text-white mt-1">Google Cloud Billing Support Specialist</h3>
          <p class="text-sm text-slate-400 mt-1 leading-relaxed">
            Managing enterprise billing infrastructures, investigating complex billing exports, architecting cost-governance guardrails, and assisting enterprises with resource optimization.
          </p>
        </div>
        <div class="relative">
          <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-slate-600 ring-4 ring-slate-950"></div>
          <span class="text-xs font-mono text-slate-400">Core Foundations</span>
          <h3 class="text-base font-semibold text-white mt-1">Cloud Operations & Technical Support</h3>
          <p class="text-sm text-slate-400 mt-1 leading-relaxed">
            Troubleshooting multi-tiered customer architectures, identifying database and compute bottlenecks, and formulating automation playbooks for issue diagnostics.
          </p>
        </div>
      </div>
    </section>

  </main>

  <footer class="border-t border-slate-800 py-8 text-center text-xs text-slate-500">
    © 2026 Harish Rettangi • Deployed via GitHub Pages
  </footer>

  <script>
    // --- Spend Simulator Logic ---
    const baseSpendSlider = document.getElementById('baseSpend');
    const baseSpendDisplay = document.getElementById('baseSpendDisplay');
    const toggleCUD = document.getElementById('toggleCUD');
    const toggleIdle = document.getElementById('toggleIdle');
    const toggleSpike = document.getElementById('toggleSpike');
    const projectedSpendDisplay = document.getElementById('projectedSpend');
    const netSavingsDisplay = document.getElementById('netSavings');
    const savingsPercentDisplay = document.getElementById('savingsPercent');

    function calculateSpend() {
      let base = parseFloat(baseSpendSlider.value);
      baseSpendDisplay.textContent = `$${base.toLocaleString()}`;

      let rate = 1.0;
      if (toggleCUD.checked) rate -= 0.35;
      if (toggleIdle.checked) rate -= 0.12;
      if (toggleSpike.checked) rate += 0.25;

      const projected = Math.round(base * rate);
      const savings = Math.max(0, base - projected);
      const percent = base > 0 ? ((savings / base) * 100).toFixed(1) : 0;

      projectedSpendDisplay.innerHTML = `$${projected.toLocaleString()}<span class="text-sm font-normal text-slate-400">/mo</span>`;
      netSavingsDisplay.textContent = `$${savings.toLocaleString()}`;
      savingsPercentDisplay.textContent = `${percent}%`;
    }

    [baseSpendSlider, toggleCUD, toggleIdle, toggleSpike].forEach(el => {
      el.addEventListener('input', calculateSpend);
      el.addEventListener('change', calculateSpend);
    });
    calculateSpend();

    // --- CLI Terminal Logic ---
    const input = document.getElementById('terminalInput');
    const history = document.getElementById('terminalHistory');

    const commands = {
      help: "Available commands: 'skills', 'finops', 'contact', 'clear'",
      skills: "Google Cloud Billing, BigQuery, SQL, FinOps Cost Governance, Python, Automation (Apps Script, n8n)",
      finops: "Specialty areas: Anomaly Detection, Committed Use Discounts (CUD), Orphaned Resource Reclamation, Labeling Taxonomies",
      contact: "Email: harishrettangi@gmail.com | Location: Hyderabad, India"
    };

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = input.value.trim().toLowerCase();
        if (cmd === 'clear') {
          history.innerHTML = '';
        } else if (cmd) {
          const entry = document.createElement('div');
          entry.innerHTML = `<span class="text-emerald-400">&gt; ${cmd}</span><br><span class="text-slate-300">${commands[cmd] || "Command not found. Type 'help' for options."}</span>`;
          history.appendChild(entry);
        }
        input.value = '';
      }
    });
  </script>
</body>
</html>

